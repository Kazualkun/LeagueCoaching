# Copie para .env APENAS em desenvolvimento. O caminho de produção é o cofre do SO.
# Nunca versione uma chave real. Chaves de desenvolvimento expiram a cada 24h.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_REGION=br1
RIOT_ROUTING=americas

# Provedores de IA — TODOS opcionais. Sem nenhum deles o `riftcoach analyze`
# entrega o relatório determinístico completo. Rode `riftcoach models` para
# ver o que está disponível e por que o resto não está.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# strict elimina todo provedor de nuvem no roteador, ANTES de qualquer outra
# consideração. Se sobrar só nuvem, o resultado é o relatório sem IA — nunca
# um envio silencioso.
PRIVACY_MODE=relaxed
